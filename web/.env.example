# Copy to .env.local for this computer. On Vercel, set the same keys in Project Settings → Environment Variables.
# Every NEXT_PUBLIC_ value is written into the page when it builds: after changing one, rebuild / redeploy.

# The site's public address, no trailing slash. Used for canonical and language (hreflang) links.
NEXT_PUBLIC_SITE_URL=http://localhost:4070

# Keeps search engines away. Leave true for demos and previews; set to false only on the real launch.
NEXT_PUBLIC_NOINDEX=true

NEXT_PUBLIC_CONTACT_EMAIL=nexthypehkt@gmail.com

# ── Chat apps ─────────────────────────────────────────────────────────
# Fill one in and it appears in the chat panel, the contact section and the main contact button.
# Leave it empty and it stays hidden. Each language lists them in the order its visitors use them:
#   Thai → LINE first · Chinese → WeChat · Russian → Telegram · English → WhatsApp
# WhatsApp: digits with country code, no + or spaces, e.g. 66812345678
NEXT_PUBLIC_CHAT_WHATSAPP=
# LINE Official Account ID including the @, e.g. @nexthype
NEXT_PUBLIC_CHAT_LINE=
# Telegram username without the @
NEXT_PUBLIC_CHAT_TELEGRAM=
# WeChat ID. WeChat has no web link, so visitors get a copy button.
NEXT_PUBLIC_CHAT_WECHAT=
# Facebook page name (facebook.com/<this>) and Instagram account (instagram.com/<this>)
NEXT_PUBLIC_CHAT_MESSENGER=NexthypeDigitalAgency
NEXT_PUBLIC_CHAT_INSTAGRAM=nexthype_th

# ── Later: NestJS API in ../server (not built yet) ────────────────────
# Server-side only (no NEXT_PUBLIC_), so it never reaches the browser.
# API_URL=http://localhost:4071
